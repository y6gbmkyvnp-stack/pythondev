   "source": [
    "total = 0\n",
    "count = 0\n",
    "\n",
    "while True:\n",
    "    score = int(input(\"点数を入力してください:\"))\n",
    "    \n",
    "    if score == -1:\n",
    "        break\n",
    "    \n",
    "    print(f\"{score}\")\n",
    "\n",
    "    total += score\n",
    "    count += 1\n",
    "\n",
    "averege = total / count\n",
    "\n",
    "print(f\"{count}人のテストの平均点は{averege}点です\")"
   ]
  }
 ],
