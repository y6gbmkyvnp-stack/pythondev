      "送料として350円かかります。\n",
      "送料込みの価格は2330.0円です\n"
     ]
    }
   ],
   "source": [
    "price = int(input(\"税込価格を入力してください:\"))\n",
    "price = price * 1.1\n",
    "if price >= 2000:\n",
    "   print(\"送料は無料です。\")\n",
    "   print(f\"税込価格は{price}円です。\")\n",
    "else:\n",
    "    price = price + 350\n",
    "    print(\"送料として350円かかります。\")\n",
    "    print(f\"送料込みの価格は{price}円です\")"
   ]
  }
 ],
